# SSH config template for admin machine (Pop!_OS / laptop)
# Copy: cp src/infra/ssh-config.template ~/.ssh/config && chmod 600 ~/.ssh/config
# Replace placeholders before use.

Host homerelay-vps
    HostName VPS_PUBLIC_IP
    User VPS_USER
    IdentityFile ~/.ssh/id_ed25519

Host homerelay
    HostName HOME_PC_VPN_IP
    User HOME_PC_USER
    ProxyJump homerelay-vps
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host homerelay-desktop
    HostName HOME_PC_VPN_IP
    User HOME_PC_USER
    ProxyJump homerelay-vps
    IdentityFile ~/.ssh/id_ed25519
    LocalForward 3389 127.0.0.1:3389
    ServerAliveInterval 60
