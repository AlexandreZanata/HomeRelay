# HomeRelay — local configuration (NEVER commit .env)
# Copy: cp .env.example .env && chmod 600 .env

# --- VPS (hub) ---
VPS_PUBLIC_IP=
VPS_USER=
VPS_VPN_IP=10.8.0.1

# --- Home PC (this machine) ---
HOME_PC_USER=
HOME_PC_VPN_IP=10.8.0.2

# --- WireGuard ---
WG_PORT=51820
WG_INTERFACE=wg0

# --- SSH (admin machine ~/.ssh/config) ---
SSH_HOST_ALIAS=homerelay

# --- Wi-Fi (only if setup needed) ---
# WIFI_SSID=
# WIFI_PASSWORD=

# --- Automations (later phases) ---
# WHATSAPP_LIBRARY=baileys
# N8N_ENABLED=false
