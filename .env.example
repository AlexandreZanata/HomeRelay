# HomeRelay — local configuration (NEVER commit .env)
# Copy: cp .env.example .env && chmod 600 .env

# --- VPS (hub) ---
VPS_PUBLIC_IP=
VPS_USER=
VPS_VPN_IP=10.8.0.1

# --- Home PC (this machine) ---
HOME_PC_USER=
HOME_PC_VPN_IP=10.8.0.2

# --- WireGuard ---
WG_PORT=51820
WG_INTERFACE=wg0

# --- SSH (admin machine ~/.ssh/config) ---
SSH_HOST_ALIAS=homerelay
VPS_SSH_HOST_ALIAS=homerelay-vps
DESKTOP_SSH_HOST_ALIAS=homerelay-desktop

# --- Remote desktop (admin machine) ---
# HOMERELAY_RDP_USER=          # defaults to SSH config User for homerelay
# HOMERELAY_PERF=balanced      # fast | balanced | quality
# HOMERELAY_GFX=AVC444         # AVC444 | RFX

# --- Wi-Fi (only if setup needed) ---
# WIFI_SSID=
# WIFI_PASSWORD=

# --- Automations (later phases) ---
# WHATSAPP_LIBRARY=baileys
# N8N_ENABLED=false
